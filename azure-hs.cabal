cabal-version:      3.0
name:               azure-hs
version:            0.1.0.0
synopsis:           Haskell SDK for Azure Blob Storage, ACS Email and Entra ID
license:            NONE
build-type:         Simple
tested-with:        GHC == 9.6.7

common shared
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints -Wmissing-deriving-strategies

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Azure.Core.Credential
    Azure.Core.Env
    Azure.Core.Error
    Azure.Core.Error.Lens
    Azure.Core.Hooks
    Azure.Core.Logger
    Azure.Core.Request
    Azure.Core.Retry
    Azure.Core.Signing
  build-depends:
    , aeson              >=2.2   && <2.3
    , base               >=4.18  && <4.19
    , base64-bytestring  >=1.2   && <1.3
    , bytestring         >=0.11  && <0.13
    , case-insensitive   >=1.2   && <1.3
    , containers         >=0.6   && <0.8
    , crypton            >=1.0   && <1.1
    , exceptions         >=0.10  && <0.11
    , http-client        >=0.7   && <0.8
    , http-types         >=0.12  && <0.13
    , lens               >=5.2   && <5.4
    , memory             >=0.18  && <0.19
    , resourcet          >=1.3   && <1.4
    , retry              >=0.9   && <0.10
    , text               >=2.0   && <2.2
    , time               >=1.12  && <1.15
    , xml-conduit        >=1.9   && <1.11

-- NOTE: build-tool-depends: hspec-discover:hspec-discover is intentionally omitted.
-- In the nix dev shell hspec-discover is already on PATH (via the ghc-with-packages
-- wrapper), and declaring it makes cabal's v2 solver reject the test plan (Cabal-7043).
test-suite spec
  import:             shared
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  other-modules:
    CredentialSpec
    ErrorSpec
    HooksSpec
    LoggerSpec
    RequestSpec
    RetrySpec
    SigningSpec
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , async
    , azure-hs
    , base
    , bytestring
    , case-insensitive
    , http-client
    , http-types
    , hspec
    , lens
    , resourcet
    , text
    , time
    , wai
    , warp
